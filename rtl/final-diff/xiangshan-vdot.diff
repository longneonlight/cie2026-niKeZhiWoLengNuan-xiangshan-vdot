+  /**
+    * vdot.vv：扩展本功能单元（FuType.vimac / VimacCfg），新增乘加归约通路。
+    *
+    * 设计要点：
+    *  1. `outData` 为流水末级数据，与 `outCtrl` 对齐，组合逻辑直接在此级计算；
+    *  2. 输出**不经 Mgu**：归约类结果直接给出完整寄存器值，
+    *     参照 `VIPU`（实现 vredsum/vwredsum）的 `res.data := vialu.io.out.bits.vd`。
+    *     这一条与译码侧的 `vdRen = F` 是**一对**：不读旧 vd，就不能再指望 Mgu 做
+    *     tail 合并，所以必须整寄存器给值。改动其中一条要同时看另一条。
+    *  3. 非法判定只有 SEW=e8 / LMUL=1 两条。`vm=0` 不在这里判：`VDOT_VV` 的 BitPat
+    *     已把 bit25 固定为 1，vm=0 在译码阶段就匹配不到本指令（落 decodeDefault），
+    *     因此 FU 内的 `!outVm` 是恒假的死条件，已删除。
+    *
+    * **面积开关**：`XSCoreParameters.hasVdot`（默认 true）。关掉时 `VDotUnit` **不例化**、
+    * 三条输出退回原样，本 FU 的硬件与未扩展前逐位相同；译码侧会同步把表项摘掉
+    * （`DecodeUnit.decode_table`），因此那种配置下 0xFA20A1D7 是不可识别指令。
+    */
+  private val hasVdot   = p(XSCoreParamsKey).hasVdot
+  private val outIsVdot = hasVdot.B && VdotOpcode.isVdot(outCtrl.fuOpType)
+
+  if (hasVdot) {
+    val vdotUnit = Module(new VDotUnit(dataWidth))
+    vdotUnit.io.vs1 := outData.src(0)
+    vdotUnit.io.vs2 := outData.src(1)
+
+    val vdotIllegal = outVecCtrl.vsew =/= VSew.e8 || outVecCtrl.vlmul =/= VLmul.m1
+
+    io.out.bits.res.data := Mux(outIsVdot, Cat(0.U((dataWidth - 32).W), vdotUnit.io.sum), mgu.io.out.vd)
+    io.out.bits.res.vxsat.get := Mux(outIsVdot, false.B, (outVxsat & mgu.io.out.active).orR)
+    io.out.bits.ctrl.exceptionVec.get(ExceptionNO.illegalInstr) :=
+      Mux(outIsVdot, vdotIllegal, mgu.io.out.illegal)
+  } else {
+    io.out.bits.res.data := mgu.io.out.vd
+    io.out.bits.res.vxsat.get := (outVxsat & mgu.io.out.active).orR
+    io.out.bits.ctrl.exceptionVec.get(ExceptionNO.illegalInstr) := mgu.io.out.illegal
+  }
 }
