 void difftest_set_ramsize(size_t ram_size){
   // should be called before difftest_init()
 #ifdef CONFIG_USE_MMAP
diff --git a/src/device/flash.c b/src/device/flash.c
index 0b735a95..66df199f 100644
--- a/src/device/flash.c
+++ b/src/device/flash.c
@@ -75,6 +75,28 @@ void load_flash_contents(const char *flash_img) {
   }
 }
 
+/**
+ * Load flash contents directly from memory (difftest API v2).
+ *
+ * 与 load_flash_contents() 的区别：v1 只拿到"路径"，没有路径时回退到
+ * CONFIG_FLASH_PRESET_CONTENT；v2 直接拿到 DUT 侧的 flash 镜像字节，
+ * 与 DUT 完全一致，因此不需要 -F 也不会有预置内容残留。
+ */
+void load_flash_contents_from_mem(const void *src, size_t size) {
+  assert(CONFIG_FLASH_SIZE <= 0x20000000UL);
+  void *ret = mmap((void *)flash_base, CONFIG_FLASH_SIZE, PROT_READ | PROT_WRITE,
+    MAP_ANONYMOUS | MAP_PRIVATE | MAP_FIXED, -1, 0);
+  if (ret != flash_base) {
+    perror("mmap");
+    assert(0);
+  }
+  size_t n = size > CONFIG_FLASH_SIZE ? CONFIG_FLASH_SIZE : size;
+  if (src != NULL && n > 0) {
+    memcpy((void *)flash_base, src, n);
+  }
+  Log("load flash from DUT via difftest_load_flash_v2: %zu bytes", n);
+}
+
 uint8_t* get_flash_base() {
   return flash_base;
 }
