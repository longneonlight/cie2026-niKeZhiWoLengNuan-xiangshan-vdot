 #endif
 }
 
+/* difftest API v2：直接接收 DUT 的 flash 镜像字节（而不是路径）。
+ * 参考模型侧据此得到与 DUT 完全相同的 flash 内容，无需 -F，也不会有
+ * CONFIG_FLASH_PRESET_CONTENT 残留导致的启动错位。 */
+void difftest_load_flash_v2(const void *flash_bin, size_t f_size){
+#ifndef CONFIG_HAS_FLASH
+  printf("nemu does not enable flash fetch!\n");
+#else
+  extern void load_flash_contents_from_mem(const void *src, size_t size);
+  load_flash_contents_from_mem(flash_bin, f_size);
+#endif
+}
